  "scenario": "# Today's imbu against Utah's stated targets (bench-targets). Needs `uv sync --extra stacks`.\n# Every size here is a choice recorded in this.i under 4j5395l8 and its children.\nscenario_schema = 1\nname = \"stock-preseeded-1home\"\ndescription = \"Target 2: from a store preseeded with 10,000 credentials, 0.1 a second at one home for 30 minutes, killing the issuer at 900 s.\"\nstages = [\"issue\"]\n\n[load]\nrates = [0.1]\nduration_s = 1800.0\nwarmup_s = 0.0\ndrain_s = 300.0\nrepetitions = 3\nmeasure = [\"requested\", \"witnessed\"]\n\n[statistics]\nlag_limit_ms = 25.0\n\n[soak]\nbucket = 30\nper_credentials = 1000\nsample_s = 60.0\n\n[stop]\ncredentials = 10000\n\n[preseed]\ncredentials = 10000\nconcurrency = 4\n\n[[faults]]\nkind = \"crash\"\ntarget = \"issuer\"\nat_s = 900.0\n\n[roles.witness_pool]\nadapter = \"heti.witness_pool\"\n[roles.witness_pool.knobs]\nknob_schema = 1\ncount = 3\n\n[roles.state_distribution]\nadapter = \"registrar.state_distribution\"\n[roles.state_distribution.knobs]\nknob_schema = 1\nwindow_s = 900.0\ndelivery_timeout_s = 450.0\nresync_s = 2700.0\n\n[roles.issuer]\nadapter = \"imbu.issuer\"\n[roles.issuer.knobs]\nknob_schema = 4\ntoad = 2\npoll_ms = \"n/a\"\nwait_s = 25.0\nanswer_rate = 2.0\nanswer_burst = 20\noperation_timeout_s = 60.0\nhomes = 1\nclients = 4\nsigner = \"lockbox\"\nsigner_latency_ms = \"n/a\"\nsigner_rate = \"n/a\"\n\n[roles.holder]\nadapter = \"heti.holder\"\n[roles.holder.knobs]\nknob_schema = 1\ntoad = 2\n\n[roles.verifier]\nadapter = \"heti.verifier\"\n[roles.verifier.knobs]\nknob_schema = 1\ntoad = 2\nfreshness_s = 900.0\nretry_ms = 5000.0\ndeadline_s = 1200.0\n",
